# Copia questo file in .env e riempi i valori. Il .env NON va su git (*.env è nel .gitignore).
# Le chiavi diventano macro C++ con prefisso ENV_ (vedi load_env.py).

# Endpoint COMPLETO, con https:// e /update-coordinates in fondo
URL_WEBSITE=https://<tuo-servizio>.up.railway.app/update-coordinates

# Deve essere identico a DEVICE_TOKEN nelle variabili del servizio Railway
DEVICE_TOKEN=

# Numero della linea servita da QUESTO token (max 3 caratteri). Solo per il
# display: al server non viene mandato, la linea la identifica il token.
# Si può cambiare anche dal portale; token e linea viaggiano sempre in coppia.
LINE_NUMBER=VIT

# Opzionale: password dell'access point del portale (min 8 caratteri).
# Vuoto = access point aperto.
PORTAL_PASSWORD=
