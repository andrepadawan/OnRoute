
# Endpoint con indirizzo COMPLETO
URL_WEBSITE=

# Deve essere identico a DEVICE_TOKEN nelle variabili del servizio Railway
DEVICE_TOKEN=


# display: al server non viene mandato, la linea la identifica il token.
# Si può cambiare anche dal portale; token e linea viaggiano sempre in coppia.
LINE_NUMBER=VIT

# Opzionale: password dell'access point del portale (min 8 caratteri).
# Vuoto = access point aperto.
PORTAL_PASSWORD=
